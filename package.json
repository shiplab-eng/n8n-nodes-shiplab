{
	"name": "@shiplab-eng/n8n-nodes-shiplab",
	"version": "0.3.0",
	"packageManager": "pnpm@10.24.0",
	"description": "n8n community nodes for the Shiplab customer API",
	"license": "MIT",
	"homepage": "https://shiplab.com",
	"keywords": [
		"n8n-community-node-package",
		"shiplab",
		"shipping",
		"invoices"
	],
	"author": {
		"name": "Shiplab",
		"email": "support@shiplab.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shiplab-eng/n8n-nodes-shiplab.git"
	},
	"bugs": {
		"url": "https://github.com/shiplab-eng/n8n-nodes-shiplab/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/ShiplabApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Shiplab/Shiplab.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
